        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Cấu hình giao diện chuẩn giống hệt hình mẫu của thầy\nskinparam roundcorner 5\nskinparam class {\n    BackgroundColor #FFF2CC\n    BorderColor #D6B656\n    HeaderBackgroundColor #FFE699\n}\nhide circle\nskinparam linetype ortho\n\nentity \&quot;KhachHang\&quot; {\n  * **PK  MaKH** : varchar(20)\n  --\n  HoTen : nvarchar(150)\n  DiaChi : nvarchar(250)\n  SoDienThoai : varchar(15)\n  LoaiKhach : nvarchar(20)\n}\n\nentity \&quot;NhanVien\&quot; {\n  * **PK  MaNV** : varchar(20)\n  --\n  HoTen : nvarchar(150)\n  SoDienThoai : varchar(15)\n}\n\nentity \&quot;NhaCungUng\&quot; {\n  * **PK  MaNCC** : varchar(20)\n  --\n  TenNCC : nvarchar(150)\n  DiaChi : nvarchar(250)\n  SoDienThoai : varchar(15)\n}\n\nentity \&quot;NhanHieu\&quot; {\n  * **PK  MaLoai** : varchar(20)\n  --\n  TenLoai : nvarchar(100)\n  * **FK  MaNCC** : varchar(20)\n}\n\nentity \&quot;NuocGiaiKhat\&quot; {\n  * **PK  MaNGK** : varchar(20)\n  --\n  TenNGK : nvarchar(150)\n  DonViTinh : nvarchar(20)\n  * **FK  MaLoai** : varchar(20)\n  SoLuongTon : int\n}\n\nentity \&quot;DonDatHang\&quot; {\n  * **PK  SoDDH** : varchar(20)\n  --\n  * **FK  MaNCC** : varchar(20)\n  * **FK  MaNV** : varchar(20)\n  NgayDatHang : date\n  NgayNhanHang : date\n}\n\nentity \&quot;ChiTietDonDatHang\&quot; {\n  * **PK, FK  SoDDH** : varchar(20)\n  * **PK, FK  MaNGK** : varchar(20)\n  --\n  SoLuongDat : int\n}\n\nentity \&quot;PhieuGiaoHang\&quot; {\n  * **PK  SoPhieuGiao** : varchar(20)\n  --\n  * **FK  SoDDH** : varchar(20)\n  DotGiao : tinyint\n  NgayGiao : date\n  SoTienPhaiTra : decimal\n  * **FK  MaNVNhan** : varchar(20)\n}\n\nentity \&quot;ChiTietPhieuGiaoHang\&quot; {\n  * **PK, FK  SoPhieuGiao** : varchar(20)\n  * **PK, FK  MaNGK** : varchar(20)\n  --\n  SoLuongGiao : int\n  DonGia : decimal\n}\n\nentity \&quot;HoaDon\&quot; {\n  * **PK  SoHoaDon** : varchar(20)\n  --\n  NgayLap : datetime\n  LoaiKhach : nvarchar(20)\n  * **FK  MaKH** : varchar(20)\n  * **FK  MaNV** : varchar(20)\n  TongTien : decimal\n  TrangThaiGiao : nvarchar(20)\n}\n\nentity \&quot;ChiTietHoaDon\&quot; {\n  * **PK, FK  SoHoaDon** : varchar(20)\n  * **PK, FK  MaNGK** : varchar(20)\n  --\n  SoLuong : int\n  SoLuongDaGiao : int\n  DonGia : decimal\n}\n\nentity \&quot;PhieuHenGiao\&quot; {\n  * **PK  MaPhieuHen** : varchar(20)\n  --\n  * **FK  SoHoaDon** : varchar(20)\n  NgayLap : date\n  NgayHenGiao : date\n  * **FK  MaNV** : varchar(20)\n  TrangThai : nvarchar(20)\n  NgayGiaoThucTe : date\n}\n\nentity \&quot;ChiTietPhieuHenGiao\&quot; {\n  * **PK, FK  MaPhieuHen** : varchar(20)\n  * **PK, FK  MaNGK** : varchar(20)\n  --\n  SoLuongHen : int\n}\n\nentity \&quot;PhieuGhiNo\&quot; {\n  * **PK  MaPhieuNo** : varchar(20)\n  --\n  * **FK, UK  SoHoaDon** : varchar(20)\n  * **FK  MaKH** : varchar(20)\n  NgayLap : date\n  SoTienNo : decimal\n  NgayDuKienTra : date\n  LyDoNo : nvarchar(300)\n  * **FK  MaNV** : varchar(20)\n}\n\n&#39; Mối quan hệ chân quạ (Crow&#39;s foot)\nNhanVien ||--o{ DonDatHang\nNhanVien ||--o{ PhieuGiaoHang\nNhanVien ||--o{ HoaDon\nNhanVien ||--o{ PhieuHenGiao\nNhanVien ||--o{ PhieuGhiNo\n\nKhachHang ||--o{ HoaDon\nKhachHang ||--o{ PhieuGhiNo\n\nNhaCungUng ||--o{ NhanHieu\nNhaCungUng ||--o{ DonDatHang\n\nNhanHieu ||--o{ NuocGiaiKhat\n\nDonDatHang ||--|{ ChiTietDonDatHang\nDonDatHang ||--o{ PhieuGiaoHang\nNuocGiaiKhat ||--o{ ChiTietDonDatHang\n\nPhieuGiaoHang ||--|{ ChiTietPhieuGiaoHang\nNuocGiaiKhat ||--o{ ChiTietPhieuGiaoHang\n\nHoaDon ||--|{ ChiTietHoaDon\nHoaDon ||--o{ PhieuHenGiao\nHoaDon ||--o| PhieuGhiNo\nNuocGiaiKhat ||--o{ ChiTietHoaDon\n\nPhieuHenGiao ||--|{ ChiTietPhieuHenGiao\nNuocGiaiKhat ||--o{ ChiTietPhieuHenGiao\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Xrv7LrTRAbrqQMn99Pea-1">
