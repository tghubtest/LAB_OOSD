        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Chỉnh màu sắc giống hệt bản mẫu của thầy\nskinparam class {\n    BackgroundColor #FFFFCC\n    BorderColor #A31515\n    ArrowColor #A31515\n    FontColor Black\n}\n\nclass PhongBan {\n  MaPB : String\n  TenPB : String\n  --\n  themPhongBan()\n  layDanhSach()\n}\n\nclass NhanVien {\n  MaNV : String\n  HoTen : String\n  NgaySinh : Date\n  SoDienThoai : String\n  DiaChi : String\n  --\n  themNhanVien()\n  layDanhSach()\n  kiemTraTonTai()\n  capNhatTrangThai()\n}\n\nclass QDTuyenDung {\n  MaQDTD : String\n  NgayLap : Date\n  ThoiGianThuViec : Integer\n  LuongThuViec : Decimal\n  --\n  themQDTuyenDung()\n  layLichSu()\n  capNhatKetQua()\n}\n\nclass HopDongLaoDong {\n  MaHD : String\n  NgayKy : Date\n  LoaiHD : String\n  --\n  themHopDong()\n  layDanhSach()\n}\n\nclass HoSoBaoHiem {\n  MaHSBH : String\n  MucDongBHXH : Decimal\n  MucDongBHYT : Decimal\n  --\n  themHoSo()\n  layHoSoTheoNV()\n  capNhatMucDong()\n}\n\nclass QDLuong {\n  MaQDL : String\n  NgayLap : Date\n  LuongCoBan : Decimal\n  PhuCapLuong : Decimal\n  PhuCapDocHai : Decimal\n  --\n  themQDLuong()\n  layLichSu()\n  layLuongHienTai()\n}\n\nclass QDChucVu {\n  MaQDCV : String\n  NgayLap : Date\n  TenChucVu : String\n  PhuCapChucVu : Decimal\n  --\n  themQDChucVu()\n  layChucVuHienTai()\n}\n\nclass QDKhenThuong_KyLuat {\n  MaQD : String\n  LoaiQD : String\n  LyDo : String\n  SoTien : Decimal\n  TrangThai : String\n  --\n  themQuyetDinh()\n  layDanhSach()\n  capNhatTrangThai()\n  tongTien()\n}\n\nclass PhieuThu_Chi {\n  SoPhieu : String\n  LoaiPhieu : String\n  NgayLap : Date\n  SoTien : Decimal\n  --\n  themPhieu()\n  layLichSu()\n  tongDaXuat()\n}\n\nclass PhieuPhuTroi {\n  SoPhieu : String\n  NgayPhuTroi : Date\n  HinhThuc : String\n  --\n  themPhieuPhuTroi()\n  layDanhSach()\n  demPhieuDat()\n}\n\nclass ChiTietPhuTroi {\n  SoGio : Float\n  --\n  themChiTiet()\n  layChiTiet()\n  tinhTienPhuTroi()\n}\n\nclass BangChamCong {\n  MaBCC : String\n  ThangNam : String\n  --\n  themBangChamCong()\n  layDanhSach()\n  tinhLuongThang()\n}\n\n&#39; =========================================\n&#39; LIÊN KẾT (Chỉ dùng mũi tên và hình thoi)\n&#39; =========================================\n\nPhongBan \&quot;1\&quot; &lt;-- \&quot;1..*\&quot; NhanVien\nNhanVien \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; QDTuyenDung\nNhanVien \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; HopDongLaoDong\n\nHopDongLaoDong \&quot;1\&quot; &lt;-- \&quot;0..1\&quot; HoSoBaoHiem\n\nNhanVien \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; QDLuong\nNhanVien \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; QDChucVu\nNhanVien \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; QDKhenThuong_KyLuat\n\nQDKhenThuong_KyLuat \&quot;1\&quot; *-- \&quot;1\&quot; PhieuThu_Chi\n\nPhongBan \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; BangChamCong\nBangChamCong \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; PhieuPhuTroi\n\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\nNhanVien \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; ChiTietPhuTroi\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iYleK7Pf2dzxq_ztYEw2-274">
