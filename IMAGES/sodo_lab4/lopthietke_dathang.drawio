        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #FFF2CC\nskinparam classBorderColor #D6B656\n\n&#39; Lớp Giao diện (Boundary)\nclass FrmDatHang {\n  + FrmDatHang_Load()\n  + btnTinhPhi_Click()\n  + btnThanhToan_Click()\n  + hienThiThongBao()\n}\n\n&#39; Lớp Điều khiển (Control / Service)\nclass DatHangService {\n  + tinhPhiGiaoHang(hinhThuc, tienHang)\n  + kiemTraThe(thongTinThe)\n  + xuLyDatHang(donHang, chiTiet)\n  + guiEmailXacNhan(email)\n}\n\n&#39; Các lớp Thực thể (Entity) liên quan\nclass KhachHang {\n  + MaKH : Integer\n  + HoTen : String\n  + Email : String\n}\n\nclass DonHang {\n  + MaDH : Integer\n  + HinhThucGiao : String\n  + TongThanhToan : Decimal\n  + taoDonHang()\n}\n\nclass ChiTietDonHang {\n  + SoLuong : Integer\n  + DonGia : Decimal\n  + themChiTiet()\n}\n\nclass ThanhToan {\n  + MaGiaoDich : String\n  + KetQua : String\n  + luuGiaoDich()\n}\n\n&#39; Mối quan hệ kiến trúc 3 lớp cho chức năng Đặt hàng\nFrmDatHang --&gt; DatHangService : Gửi yêu cầu\nDatHangService --&gt; KhachHang : Truy vấn KH\nDatHangService --&gt; DonHang : Tạo mới đơn\nDonHang *-- ChiTietDonHang : Hợp thành\nDatHangService --&gt; ThanhToan : Lưu kết quả GD\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="e2-bAmqGz3tmn_9SnJBB-1">
